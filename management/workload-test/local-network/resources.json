{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "database-ingress",
        "namespace": "report-gitops"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "cnpg.io/cluster": "report-db"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "cnpg-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "cloudnative-pg"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8000
              },
              {
                "protocol": "TCP",
                "port": 5432
              }
            ]
          },
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "cnpg.io/cluster": "report-db"
                  }
                }
              },
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "report-workshop"
                  }
                }
              },
              {
                "podSelector": {
                  "matchLabels": {
                    "portfolio.whitt.uk/network-probe": "allowed"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 5432
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "database-egress",
        "namespace": "report-gitops"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "cnpg.io/cluster": "report-db"
          }
        },
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "podSelector": {
                  "matchLabels": {
                    "cnpg.io/cluster": "report-db"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 5432
              }
            ]
          },
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "UDP",
                "port": 53
              },
              {
                "protocol": "TCP",
                "port": 53
              }
            ]
          },
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "${KIND_API_ENDPOINT}/32"
                }
              },
              {
                "ipBlock": {
                  "cidr": "${KIND_API_SERVICE}/32"
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 443
              },
              {
                "protocol": "TCP",
                "port": 6443
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "allowed-probe-egress",
        "namespace": "report-gitops"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "portfolio.whitt.uk/network-probe": "allowed"
          }
        },
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "podSelector": {
                  "matchLabels": {
                    "cnpg.io/cluster": "report-db"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 5432
              }
            ]
          }
        ]
      }
    }
  ]
}
