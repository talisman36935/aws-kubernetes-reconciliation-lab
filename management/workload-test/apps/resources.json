              "podAntiAffinity": {
                "requiredDuringSchedulingIgnoredDuringExecution": [
                  {
                    "labelSelector": {
                      "matchLabels": {
                        "app.kubernetes.io/name": "report-workshop",
                        "app.kubernetes.io/component": "api"
                      }
                    },
                    "topologyKey": "kubernetes.io/hostname"
