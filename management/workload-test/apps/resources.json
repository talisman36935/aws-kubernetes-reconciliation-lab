                "args": [
                  "api"
                ],
                "env": [
                  {
                    "name": "DATABASE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "report-db-app",
                        "key": "uri"
                      }
                    }
                  },
                  {
                    "name": "METRICS_ADDR",
                    "value": "0.0.0.0:9090"
