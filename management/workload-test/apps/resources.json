          },
          "spec": {
            "serviceAccountName": "report-workshop",
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 45,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "topologySpreadConstraints": [
              {
                "maxSkew": 1,
